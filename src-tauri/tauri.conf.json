{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stellar RDIRSTAT",
  "mainBinaryName": "rdirstat",
  "version": "0.1.0",
  "identifier": "jbelke.rdirstat",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stellar RDIRSTAT",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "Joshua Belke",
    "homepage": "https://github.com/jbelke/RDirStat",
    "copyright": "Copyright (C) 2026 Joshua Belke. Licensed under AGPL-3.0-only; commercial licensing at LICENSING.md.",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "shortDescription": "Disk usage and file inventory for macOS",
    "longDescription": "Stellar RDIRSTAT maps where space goes on very large macOS volumes: a scanned tree, a treemap, file-type and size reports, and an honest account of what macOS will and will not let it read.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
