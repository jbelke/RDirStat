# Stellar RDIRSTAT — development environment.
#
#   cp .env.development.example .env.development
#
# `./rush.sh dev` exports every key below into the child process before
# launching, and the application treats a real environment variable as higher
# precedence than the `.env` file it reads on its own (src-tauri/src/settings.rs).
# So this file wins over `.env` without replacing it, and `.env` still works for
# anyone running `pnpm tauri dev` directly.
#
# Tracked in git as a template. The copy without `.example` is ignored — put
# machine-specific paths and anything secret there, never here.

# Label only. Shown by `./rush.sh doctor` and used to name Docker resources.
RDIRSTAT_ENV=development

# Where completed scans are cached as *.rdstat snapshots.
#
# Development points somewhere disposable on purpose: a full-volume scan costs
# roughly a gigabyte, and a dev build should never be able to evict the
# snapshots the installed release is using.
RDIRSTAT_DATA_DIR=./.local/development/snapshots

# Tracing filter for the Rust side. Without this the default is
# `rdirstat=info,warn`.
RUST_LOG=rdirstat=debug,warn

# Vite emits sourcemaps and skips minification when this is set, which is what
# makes the webview inspector usable.
TAURI_ENV_DEBUG=1

# --- Docker profile knobs (`./rush.sh up -e development`) ----------------------
# Only read by docker-compose.yml. The desktop application ignores them.
COMPOSE_PROJECT_NAME=stellar-rdirstat-dev
# Host port for the Vite dev server in the `dev` profile.
DEV_PORT=1420
# Host port for the built frontend in the `web` profile.
WEB_PORT=4173
NODE_ENV=development
