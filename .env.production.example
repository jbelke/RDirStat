# Stellar RDIRSTAT — production environment.
#
#   cp .env.production.example .env.production
#
# This is the environment `./rush.sh dmg` uses by default. It carries the
# release bundle identifier from src-tauri/tauri.conf.json, so anything here
# that points at a directory points at the one real users' data lives in.
#
# Tracked in git as a template. The copy without `.example` is ignored.
#
# NOTHING SECRET BELONGS IN EITHER FILE. The signing keys below are read from
# the process environment by the Tauri bundler; keep them in the Keychain, a
# password manager, or CI secrets, and export them for the one command that
# needs them.

RDIRSTAT_ENV=production

# Leave unset in a real production install.
#
# The application already resolves the snapshot store from the storage panel
# and then from ~/Library/Application Support/<bundle id>/snapshots, and a
# bundled .app is launched with a working directory of `/` so it never sees a
# dotenv file anyway. Setting it here only affects builds and runs started from
# this checkout — which is the point during a release rehearsal, and a
# misconfiguration in the hands of a user.
# RDIRSTAT_DATA_DIR=

# Errors and warnings only. `debug` on a full-volume scan writes a line per
# directory, which is both a performance cost and a privacy one: those lines
# are the user's filenames.
RUST_LOG=rdirstat=warn,error

# --- Docker profile knobs (`./rush.sh up -e production`) ----------------------
COMPOSE_PROJECT_NAME=stellar-rdirstat-prod
DEV_PORT=1422
WEB_PORT=4175
NODE_ENV=production

# --- Signing and notarization -------------------------------------------------
# Required for a .dmg that opens on a Mac other than the one that built it.
# Without them the bundle is ad-hoc signed, Gatekeeper quarantines it, and the
# user gets "Stellar RDIRSTAT is damaged and can't be opened" — which is a
# signing failure wearing a corruption message.
#
# `./rush.sh dmg -e production` reports which of these are set before it
# builds, and refuses to claim a build is distributable when they are not.
#
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# APPLE_TEAM_ID=TEAMID
# APPLE_ID=you@example.com
# APPLE_PASSWORD=app-specific-password   # prefer a keychain reference
