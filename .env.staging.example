# Stellar RDIRSTAT — staging environment.
#
#   cp .env.staging.example .env.staging
#
# Staging is a release-shaped build that installs *beside* production rather
# than over it: src-tauri/tauri.staging.conf.json gives it its own bundle
# identifier, so its settings, snapshot store and Keychain items are a
# different set of files. That is the only honest way to test an upgrade.
#
# Tracked in git as a template. The copy without `.example` is ignored — put
# machine-specific paths and anything secret there, never here.

RDIRSTAT_ENV=staging

# Separate from production's store, because the bundle identifier is separate.
# Pointing both at one directory would let a staging build prune the release's
# snapshots, which is exactly the accident the split identifier prevents.
RDIRSTAT_DATA_DIR=./.local/staging/snapshots

# Release build, but keep the warnings audible: staging exists to surface the
# failure modes production users would only ever report second-hand.
RUST_LOG=rdirstat=info,warn

# --- Docker profile knobs (`./rush.sh up -e staging`) -------------------------
COMPOSE_PROJECT_NAME=stellar-rdirstat-staging
DEV_PORT=1421
WEB_PORT=4174
NODE_ENV=production

# --- Signing (optional for staging) -------------------------------------------
# An unsigned staging .dmg is fine on the machine that built it and useless
# anywhere else: Gatekeeper quarantines it on any other Mac. Fill these in to
# test the signed path before production depends on it.
#
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# APPLE_TEAM_ID=TEAMID
