# ---------------------------------------------------------------------------
# Rust / Cargo build output
# ---------------------------------------------------------------------------
target/
**/*.rs.bk
*.pdb

# ---------------------------------------------------------------------------
# Tauri generated / bundled artifacts
# ---------------------------------------------------------------------------
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/WixTools/
.tauri/

# ---------------------------------------------------------------------------
# Node / pnpm dependency output and frontend build output
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Scan artifacts, reporting store, benchmark output.
#
# Snapshots (02), the Parquet/DuckDB history (06), and measurement output are
# local data, not source. A fixture that CI depends on must be added
# explicitly with `git add -f`.
# ---------------------------------------------------------------------------
*.rdstat
*.duckdb
*.duckdb.wal
*.parquet
/scans/
# Per-environment scratch: snapshot stores the .env.<environment> templates
# point at. Data, never source.
/.local/
/bench-results/
/criterion/

# ---------------------------------------------------------------------------
# Generated secrets, signing material, app data
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# Per-environment templates ARE tracked; the real .env.<environment>
# files they are copied to are not. See rush.sh --help.
!.env.*.example
# Developer ID / notarization material (phase 5). Never committed.
*.p12
*.pem
*.key
*.cer
*.mobileprovision

# ---------------------------------------------------------------------------
# Agent tooling payloads (installed, not authored here)
#
# .agents/ is the lock-managed skill payload pinned by skills-lock.json.
# skills/rust-skills and .claude/skills/rust-skills are tracked symlinks into
# it, so a clean checkout has dangling links until the skills are installed --
# that is expected, and nothing in the build reads them.
# ---------------------------------------------------------------------------
.agents/
.claude/settings.local.json
# Local developer material. Never public.
.settings/

# ---------------------------------------------------------------------------
# Beads issue tracker.
#
# .beads/ IS tracked: its config and the issues.jsonl export ride the
# repository so a fresh clone sees the backlog. Only the local Dolt working
# database is excluded.
# ---------------------------------------------------------------------------
.beads/*.db
.beads/*.db-*

# ---------------------------------------------------------------------------
# macOS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
